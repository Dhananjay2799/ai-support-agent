# Copy the API section to apps/api/.env and the web section to apps/web/.env.local.
# Never commit real values.

# ---------------------------------------------------------------- API (apps/api/.env)
ENVIRONMENT=local
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Supabase > Connect > Transaction pooler URI (port 6543). Needed from Day 2.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres
# Needed from Day 2 (embeddings, agent, voice)
OPENAI_API_KEY=
# Enables demo personas and the chaos panel
DEMO_MODE=true

# ---------------------------------------------------------- Web (apps/web/.env.local)
# Public URL of the API, baked into the browser bundle at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
