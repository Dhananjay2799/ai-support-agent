# Copy the API section to apps/api/.env and the web section to apps/web/.env.local.
# Never commit real values.

# ---------------------------------------------------------------- API (apps/api/.env)
ENVIRONMENT=local
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Supabase > Connect > Transaction pooler URI (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres
# Embeddings, the agent, the support judge and GPT-Live voice
OPENAI_API_KEY=
# Demo personas signed in from the UI, the failure simulator and the reset button
DEMO_MODE=true
# Optional: enables POST /admin/ingest (load the knowledge base into a deployed database)
ADMIN_TOKEN=

# Optional overrides (defaults shown)
# AGENT_MODEL=gpt-6-luna
# JUDGE_MODEL=gpt-6-luna
# AGENT_FALLBACK_MODEL=gpt-5.4-mini
# AGENT_REASONING_EFFORT=low

# Abuse protection for a public deployment (defaults shown)
# RATE_LIMITS_ENABLED=true
# CHAT_PER_SESSION_PER_MINUTE=20
# CHAT_PER_IP_PER_HOUR=150
# VOICE_CALLS_PER_IP_PER_HOUR=8
# RESETS_PER_IP_PER_HOUR=12
# Chat and voice pause for the rest of the UTC day once spend reaches this
# DAILY_BUDGET_USD=5
# Client IPs are stored only as salted hashes; set your own salt in production
# IP_HASH_SALT=

# ---------------------------------------------------------- Web (apps/web/.env.local)
# Public URL of the API, baked into the browser bundle at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
