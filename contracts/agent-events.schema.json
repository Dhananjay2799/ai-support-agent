{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contracts",
  "description": "Generated from apps/api/app/contracts. Do not edit by hand.",
  "type": "object",
  "properties": {
    "event": {
      "$ref": "#/definitions/AgentEvent"
    },
    "voiceEvent": {
      "$ref": "#/definitions/VoiceEvent"
    },
    "chatRequest": {
      "$ref": "#/definitions/ChatRequest"
    },
    "voiceRequest": {
      "$ref": "#/definitions/VoiceRequest"
    }
  },
  "definitions": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Passage id, e.g. 'refunds-and-billing#5'",
          "type": "string"
        },
        "doc_title": {
          "type": "string"
        },
        "section": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "doc_title",
        "section"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationsEvent": {
      "additionalProperties": false,
      "description": "Knowledge-base passages the answer cited, after checking they were retrieved.",
      "properties": {
        "type": {
          "const": "citations",
          "default": "citations",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/definitions/Citation"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "citations"
      ],
      "title": "CitationsEvent",
      "type": "object"
    },
    "DoneEvent": {
      "additionalProperties": false,
      "description": "Always the last event of a turn.",
      "properties": {
        "type": {
          "const": "done",
          "default": "done",
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/definitions/Usage"
        },
        "cost_usd": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "latency_ms": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "turn_id",
        "usage",
        "cost_usd",
        "latency_ms"
      ],
      "title": "DoneEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        },
        "code": {
          "enum": [
            "llm_timeout",
            "rate_limited",
            "tool_failed",
            "budget_exceeded",
            "internal"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "EscalationEvent": {
      "additionalProperties": false,
      "description": "The conversation was handed to a human; the agent stops taking actions.",
      "properties": {
        "type": {
          "const": "escalation",
          "default": "escalation",
          "type": "string"
        },
        "ticket_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "type": "string"
        },
        "first_response_hours": {
          "description": "First-reply target for the customer's plan",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "ticket_id",
        "reason",
        "priority",
        "first_response_hours"
      ],
      "title": "EscalationEvent",
      "type": "object"
    },
    "GuardrailEvent": {
      "additionalProperties": false,
      "description": "Outcome of the confidence gate for the current answer.",
      "properties": {
        "type": {
          "const": "guardrail",
          "default": "guardrail",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "decision": {
          "enum": [
            "answer",
            "verify",
            "escalate"
          ],
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "confidence",
        "decision",
        "reason"
      ],
      "title": "GuardrailEvent",
      "type": "object"
    },
    "JsonValue": {},
    "Span": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "node",
            "llm",
            "tool",
            "retrieval",
            "guardrail",
            "voice"
          ],
          "type": "string"
        },
        "start_ms": {
          "description": "Milliseconds since the turn started",
          "type": "number"
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attributes": {
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "type": "object"
        }
      },
      "required": [
        "id",
        "parent_id",
        "name",
        "kind",
        "start_ms",
        "end_ms",
        "attributes"
      ],
      "title": "Span",
      "type": "object"
    },
    "StepEvent": {
      "additionalProperties": false,
      "description": "A tool started, completed or failed. `id` is unique per tool invocation.",
      "properties": {
        "type": {
          "const": "step",
          "default": "step",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "label": {
          "description": "Human-readable status, e.g. 'Verifying account tier…'",
          "type": "string"
        },
        "status": {
          "enum": [
            "started",
            "completed",
            "failed"
          ],
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "id",
        "tool",
        "label",
        "status",
        "duration_ms",
        "detail"
      ],
      "title": "StepEvent",
      "type": "object"
    },
    "TokenEvent": {
      "additionalProperties": false,
      "description": "A chunk of the assistant's reply text.",
      "properties": {
        "type": {
          "const": "token",
          "default": "token",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TokenEvent",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "description": "Everything one turn did, as a tree of spans; sent just before `done`.",
      "properties": {
        "type": {
          "const": "trace",
          "default": "trace",
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/definitions/Span"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "turn_id",
        "spans"
      ],
      "title": "TraceEvent",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "cached_tokens": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_tokens"
      ],
      "title": "Usage",
      "type": "object"
    },
    "VoiceEndedEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "voice_ended",
          "default": "voice_ended",
          "type": "string"
        },
        "reason": {
          "enum": [
            "hangup",
            "time_limit",
            "closed",
            "error"
          ],
          "type": "string"
        },
        "duration_ms": {
          "type": "number"
        },
        "billed_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Voice time GPT-Live billed, when it reported usage"
        },
        "voice_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost of the voice session itself; agent turns are priced separately"
        }
      },
      "required": [
        "type",
        "reason",
        "duration_ms",
        "billed_seconds",
        "voice_cost_usd"
      ],
      "title": "VoiceEndedEvent",
      "type": "object"
    },
    "VoiceSessionEvent": {
      "additionalProperties": false,
      "description": "First event of a call: the WebRTC answer for the browser's offer.",
      "properties": {
        "type": {
          "const": "voice_session",
          "default": "voice_session",
          "type": "string"
        },
        "live_session_id": {
          "type": "string"
        },
        "sdp": {
          "description": "SDP answer to apply as the peer connection's remote description",
          "type": "string"
        },
        "max_seconds": {
          "description": "The call is closed after this long",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "live_session_id",
        "sdp",
        "max_seconds"
      ],
      "title": "VoiceSessionEvent",
      "type": "object"
    },
    "VoiceTurnEvent": {
      "additionalProperties": false,
      "description": "The customer's spoken request, sent before the agent turn that handles it.",
      "properties": {
        "type": {
          "const": "voice_turn",
          "default": "voice_turn",
          "type": "string"
        },
        "utterance": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "utterance"
      ],
      "title": "VoiceTurnEvent",
      "type": "object"
    },
    "AgentEvent": {
      "discriminator": {
        "mapping": {
          "citations": "#/definitions/CitationsEvent",
          "done": "#/definitions/DoneEvent",
          "error": "#/definitions/ErrorEvent",
          "escalation": "#/definitions/EscalationEvent",
          "guardrail": "#/definitions/GuardrailEvent",
          "step": "#/definitions/StepEvent",
          "token": "#/definitions/TokenEvent",
          "trace": "#/definitions/TraceEvent"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/TokenEvent"
        },
        {
          "$ref": "#/definitions/StepEvent"
        },
        {
          "$ref": "#/definitions/GuardrailEvent"
        },
        {
          "$ref": "#/definitions/EscalationEvent"
        },
        {
          "$ref": "#/definitions/CitationsEvent"
        },
        {
          "$ref": "#/definitions/TraceEvent"
        },
        {
          "$ref": "#/definitions/ErrorEvent"
        },
        {
          "$ref": "#/definitions/DoneEvent"
        }
      ]
    },
    "VoiceEvent": {
      "discriminator": {
        "mapping": {
          "citations": "#/definitions/CitationsEvent",
          "done": "#/definitions/DoneEvent",
          "error": "#/definitions/ErrorEvent",
          "escalation": "#/definitions/EscalationEvent",
          "guardrail": "#/definitions/GuardrailEvent",
          "step": "#/definitions/StepEvent",
          "token": "#/definitions/TokenEvent",
          "trace": "#/definitions/TraceEvent",
          "voice_ended": "#/definitions/VoiceEndedEvent",
          "voice_session": "#/definitions/VoiceSessionEvent",
          "voice_turn": "#/definitions/VoiceTurnEvent"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/VoiceSessionEvent"
        },
        {
          "$ref": "#/definitions/VoiceTurnEvent"
        },
        {
          "$ref": "#/definitions/VoiceEndedEvent"
        },
        {
          "$ref": "#/definitions/TokenEvent"
        },
        {
          "$ref": "#/definitions/StepEvent"
        },
        {
          "$ref": "#/definitions/GuardrailEvent"
        },
        {
          "$ref": "#/definitions/EscalationEvent"
        },
        {
          "$ref": "#/definitions/CitationsEvent"
        },
        {
          "$ref": "#/definitions/TraceEvent"
        },
        {
          "$ref": "#/definitions/ErrorEvent"
        },
        {
          "$ref": "#/definitions/DoneEvent"
        }
      ]
    },
    "ChatRequest": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "description": "One id per conversation, shared by chat and voice",
          "format": "uuid",
          "type": "string"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        "persona_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Demo persona acting as the signed-in customer"
        },
        "simulate": {
          "anyOf": [
            {
              "enum": [
                "llm_timeout",
                "rate_limit",
                "tool_error",
                "tool_outage"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Demo only: inject one failure into this turn to show how it's recovered"
        }
      },
      "required": [
        "session_id",
        "message"
      ],
      "title": "ChatRequest",
      "type": "object"
    },
    "VoiceRequest": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "description": "The conversation the call joins; same id as chat",
          "format": "uuid",
          "type": "string"
        },
        "persona_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sdp": {
          "description": "The browser's WebRTC SDP offer",
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "sdp"
      ],
      "title": "VoiceRequest",
      "type": "object"
    }
  }
}
